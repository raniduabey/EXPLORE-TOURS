# Ceylon Explore Tours - Environment Variables Reference

# Database Configuration (SQLite default for local dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# Admin Authentication
ADMIN_EMAIL="admin@ceylonexploretours.com"
ADMIN_PASSWORD="ChangeThisToAStrongSecretPasswordInProduction!"
JWT_SECRET="generate-a-strong-random-secret-key-for-session-tokens-min-32-chars"

# Canonical Site URL
NEXT_PUBLIC_SITE_URL="https://www.ceylonexploretours.com"

# Public Business & Contact Information
NEXT_PUBLIC_CONTACT_EMAIL="info@ceylonexploretours.com"
NEXT_PUBLIC_SUPPORT_EMAIL="support@ceylonexploretours.com"
NEXT_PUBLIC_CONTACT_PHONE="+94771234567"
NEXT_PUBLIC_CONTACT_PHONE_DISPLAY="+94 77 123 4567"
NEXT_PUBLIC_WHATSAPP_NUMBER="94771234567"
NEXT_PUBLIC_WHATSAPP_DISPLAY="+94 77 123 4567"

# Verified Official Certifications (Leave empty if unverified; claims will be safely hidden)
NEXT_PUBLIC_SLTDA_REGISTRATION=""
NEXT_PUBLIC_BUSINESS_REGISTRATION=""

# Analytics & Ad Tracking (Activates only when set)
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# Payment Gateways (Optional: will activate gateway cards when set)
# PayHere Sri Lanka
PAYHERE_MERCHANT_ID=""
PAYHERE_MERCHANT_SECRET=""
PAYHERE_MODE="sandbox" # or "live"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
