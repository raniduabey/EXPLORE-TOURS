datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("SUPER_ADMIN") // SUPER_ADMIN, CONTENT_MANAGER, BOOKING_MANAGER
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  adminEmail String
  action     String
  entityType String
  entityId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String
  role      String    @default("CUSTOMER")
  phone     String?
  avatar    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]
}

model Destination {
  id                 String   @id @default(uuid())
  name               String   @unique
  slug               String   @unique
  shortDesc          String
  longDesc           String
  image              String
  experienceCount    Int      @default(0)
  startingPrice      Float    @default(0)
  popularAttractions String
  bestTimeToVisit    String
  featured           Boolean  @default(false)
  status             String   @default("PUBLISHED") // PUBLISHED, DRAFT, ARCHIVED
  seoTitle           String?
  seoDescription     String?
  tours              Tour[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  icon        String
  description String
  image       String
  tours       Tour[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model Tour {
  id                 String          @id @default(uuid())
  title              String
  slug               String          @unique
  location           String
  destinationId      String?
  destination        Destination?    @relation(fields: [destinationId], references: [id])
  categoryId         String?
  category           Category?       @relation(fields: [categoryId], references: [id])
  duration           String
  durationHours      Int             @default(8)
  rating             Float           @default(0) // Computed dynamically from approved reviews
  reviewCount        Int             @default(0) // Count of approved reviews
  bookedCount        Int             @default(0)
  price              Float
  previousPrice      Float?
  adultPrice         Float?
  childPrice         Float?
  tourType           String          @default("Private Tour")
  badge              String?
  freeCancellation   Boolean         @default(true)
  instantBook        Boolean         @default(true)
  pickupAvailable    Boolean         @default(true)
  guideIncluded      Boolean         @default(true)
  liveGuide          String          @default("English")
  languages          String          @default("English")
  minTravellers      Int             @default(1)
  maxTravellers      Int             @default(15)
  description        String
  highlights         String
  includes           String
  excludes           String
  importantInfo      String?
  whatToBring        String?
  cancellationPolicy String?
  featured           Boolean         @default(false)
  status             String          @default("PUBLISHED") // PUBLISHED, DRAFT, ARCHIVED
  seoTitle           String?
  seoDescription     String?
  images             TourImage[]
  itinerary          ItineraryItem[]
  bookings           Booking[]
  reviews            Review[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model TourImage {
  id        String  @id @default(uuid())
  tourId    String
  tour      Tour    @relation(fields: [tourId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  isPrimary Boolean @default(false)
  order     Int     @default(0)
}

model ItineraryItem {
  id          String  @id @default(uuid())
  tourId      String
  tour        Tour    @relation(fields: [tourId], references: [id], onDelete: Cascade)
  stepNumber  Int
  title       String
  description String
  location    String?
  duration    String?
}

model Booking {
  id              String             @id @default(uuid())
  bookingRef      String             @unique
  userId          String?
  user            User?              @relation(fields: [userId], references: [id])
  tourId          String
  tour            Tour               @relation(fields: [tourId], references: [id])
  tourDate        String
  tourTime        String
  adults          Int                @default(1)
  children        Int                @default(0)
  infants         Int                @default(0)
  guestName       String
  guestEmail      String
  guestPhone      String
  guestCountry    String
  pickupLocation  String
  specialRequests String?
  totalAmount     Float
  currency        String             @default("USD")
  paymentMethod   String             @default("PayHere")
  paymentStatus   String             @default("PENDING") // UNPAID, PENDING, PAID, REFUNDED
  bookingStatus   String             @default("PENDING") // PENDING, CONFIRMED, COMPLETED, CANCELLED
  adminNotes      String?
  reviews         Review[]
  invitations     ReviewInvitation[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @default(now()) @updatedAt
}

model Review {
  id              String   @id @default(uuid())
  tourId          String?
  tour            Tour?    @relation(fields: [tourId], references: [id], onDelete: Cascade)
  bookingId       String?
  booking         Booking? @relation(fields: [bookingId], references: [id])
  userName        String
  userEmail       String?
  userCountry     String   @default("International")
  userAvatar      String?
  photoUrl        String?
  rating          Float
  guideRating     Float    @default(5.0)
  transportRating Float    @default(5.0)
  valueRating     Float    @default(5.0)
  comment         String
  travelDate      String
  verified        Boolean  @default(false)
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED, HIDDEN
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
}

model ReviewInvitation {
  id         String    @id @default(uuid())
  token      String    @unique
  bookingId  String
  booking    Booking   @relation(fields: [bookingId], references: [id])
  tourId     String
  guestEmail String
  guestName  String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
}

model Coupon {
  id             String    @id @default(uuid())
  code           String    @unique
  discountType   String    @default("PERCENT")
  discountAmount Float
  minSpend       Float     @default(0)
  usageLimit     Int       @default(100)
  usageCount     Int       @default(0)
  active         Boolean   @default(true)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
}

model BlogPost {
  id             String   @id @default(uuid())
  title          String
  slug           String   @unique
  excerpt        String
  content        String
  image          String
  category       String
  author         String
  readTime       String   @default("5 min read")
  featured       Boolean  @default(false)
  status         String   @default("PUBLISHED") // PUBLISHED, DRAFT, ARCHIVED
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
}

model CustomTripRequest {
  id             String   @id @default(uuid())
  name           String
  email          String
  phone          String
  country        String
  travelDates    String
  duration       String
  budget         String
  travelers      String
  accommodation  String
  transportation String
  destinations   String
  interests      String
  specialNotes   String?
  status         String   @default("NEW") // NEW, CONTACTED, IN_PROGRESS, CLOSED
  adminNotes     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
}

model HeroSlide {
  id                String   @id @default(uuid())
  tagline           String
  headlineLine1     String
  headlineHighlight String
  subtitle          String
  image             String
  destination       String
  ctaText           String
  ctaLink           String
  active            Boolean  @default(true)
  orderIndex        Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model FaqItem {
  id         String   @id @default(uuid())
  question   String
  answer     String
  category   String   @default("General")
  orderIndex Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model MediaAsset {
  id        String   @id @default(uuid())
  url       String
  filename  String
  title     String?
  altText   String?
  fileSize  Int?
  mimeType  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model WebsiteContent {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  category  String   @default("general")
  updatedAt DateTime @updatedAt
}

model BusinessSettings {
  id             String   @id @default("default")
  companyName    String   @default("Ceylon Explore Tours")
  address        String   @default("No. 45, Temple Road, Colombo 03, Sri Lanka")
  email          String   @default("info@ceylonexploretours.com")
  primaryPhone   String   @default("+94 77 123 4567")
  secondaryPhone String   @default("+94 11 234 5678")
  whatsapp       String   @default("+94 77 123 4567")
  mapsUrl        String   @default("https://maps.google.com/?q=Colombo+Sri+Lanka")
  operatingHours String   @default("Mon - Sun: 06:00 AM - 10:00 PM (24/7 Hotline)")
  updatedAt      DateTime @updatedAt
}

